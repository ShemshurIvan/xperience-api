# Copy this file to .env and set your own password:
#   cp .env.example .env
# .env is ignored by git, so the real password never gets committed.

POSTGRES_DB=xperience
POSTGRES_USER=xperience
POSTGRES_PASSWORD=change-me

# Signs the login tokens. Use a long random value, at least 32 characters, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-32-plus-chars